# Copia a .env (nunca publiques claves ni envies datos clinicos reales).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Modelo del nuevo adaptador de Google AI Studio (API Interactions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Predeterminado: no guardar transcripciones de pacientes
SAVE_TRANSCRIPTS=0
