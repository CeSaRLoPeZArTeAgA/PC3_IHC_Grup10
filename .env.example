# Copia este archivo a .env y completa solo las claves que tengas.
# Nunca publiques .env ni claves reales. Sin claves, la app funciona en modo texto.

PORT=4173

# Groq: preguntas del asistente y transcripcion de espanol
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Gemini: resumen, borrador medico y audio experimental en quechua
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Rutas opcionales (por defecto se usan data/runtime.json y data/profiles.json)
# STORAGE_FILE=
# PROFILES_FILE=
